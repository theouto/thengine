#version 450
#extension GL_EXT_shader_image_load_formatted : require
#extension GL_EXT_nonuniform_qualifier : enable

//test shader taken from: https://vkguide.dev/docs/new_chapter_2/vulkan_shader_code/

//size of a workgroup for compute
layout (local_size_x = 16, local_size_y = 16) in;

layout(rgba8, set = 0, binding = 0) uniform image2D image[];
layout(rgba8, set = 1, binding = 0) uniform readonly image2D textures[];

layout(push_constant) uniform Push 
{
    int frameIndex;
    int width;
    int height;
} push;


void main() 
{
  ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(image[nonuniformEXT(push.frameIndex)]);

  if(texelCoord.x < size.x && texelCoord.y < size.y)
  {
    vec4 color = vec4(0.0, 0.0, 1.0, 1.0);

    if(gl_LocalInvocationID.x != 0 && gl_LocalInvocationID.y != 0)
    {
      color.xy = vec2(float(texelCoord.x)/size.x, float(texelCoord.y)/size.y);//imageLoad(textures[nonuniformEXT(3)], texelCoord/size).xyz;
    }

    imageStore(image[nonuniformEXT(push.frameIndex)], texelCoord, color);
  }
}
