#version 450
#extension GL_EXT_shader_image_load_formatted : require
#extension GL_EXT_nonuniform_qualifier : enable

//size of a workgroup for compute
layout (local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D textures[];
layout(set = 1, binding = 1) uniform sampler2D imageBuffers[];
layout(rgba8, set = 1, binding = 0) uniform image2D image[];


layout(push_constant) uniform Push 
{
  int frameIndex;
  int width;
  int height;
} push;


void main()
{
  ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(image[nonuniformEXT(1)]);

  if(texelCoord.x < size.x && texelCoord.y < size.y)
  {
    vec4 color = vec4(push.frameIndex/3.0, push.frameIndex/5.0, push.frameIndex/10.0,1.0);
    //color = imageLoad(image[nonuniformEXT(2 + push.frameIndex)], texelCoord);
    if (color.w == 0.0) return;

    imageStore(image[nonuniformEXT(1)], texelCoord, color);
  }
}
