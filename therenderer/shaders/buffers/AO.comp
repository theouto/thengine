#version 450
#extension GL_EXT_shader_image_load_formatted : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_scalar_block_layout : enable

layout (local_size_x = 32, local_size_y = 32) in;

layout(set = 1, binding = 0) uniform sampler2D textures[];
layout(set = 2, binding = 1) uniform sampler2D imageBuffers[];
layout(rgba16f, set = 2, binding = 0) uniform image2D image[];

#include "../include/common.glsl"

const float pi = M_PI;
const float twoPi = 2.0 * pi;
const float halfPi = 0.5 * pi;

layout(set = 0, binding = 0) uniform GlobalUbo 
{
  mat4 projection;
  mat4 view;
  mat4 invView;
  mat4 viewStat;
  vec3 lightPos;
  int numLights;
  vec4 depthValues;
  vec4 ambientLightColor; //RGB Intensity
  PointLight pointLights[10];
  int width;
  int height;
  float near;
  float far;
  mat4 lightSpaceMatrix[4];
  int frameIndex;
} ubo;

layout(push_constant) uniform Push 
{
  int frameIndex;
  int width;
  int height;
} push;

//https://cdrinmatane.github.io/posts/ssaovb-code/
const uint sectorCount = 32u;
uint updateSectors(float minHorizon, float maxHorizon, uint outBitfield) 
{
    uint startBit = uint(minHorizon * float(sectorCount));
    uint horizonAngle = uint(ceil((maxHorizon - minHorizon) * float(sectorCount)));
    uint angleBit = horizonAngle > 0u ? uint(0xFFFFFFFFu >> (sectorCount - horizonAngle)) : 0u;
    uint currentBitfield = angleBit << startBit;
    return outBitfield | currentBitfield;
}

float vectorAngleXY(vec3 angled)
{
  vec3 xyPlane = vec3(1.f, 1.f, 0.f);

  float num = dot(angled, xyPlane);
  float dom = length(angled) * length(xyPlane);

  return fastacos(num/dom);
}

// https://blog.demofox.org/2022/01/01/interleaved-gradient-noise-a-different-kind-of-low-discrepancy-sequence/
float randf(int x, int y) {
    return mod(52.9829189 * mod(0.06711056 * float(x) + 0.00583715 * float(y), 1.0), 1.0);
}

//I am aware that this does mean a subtle precision loss when sampling
//the image buffer, but this is an acceptable tradeoff for an ambient occlusion buffer,
//I just care about speed, and texelFetch is a LOT faster than sampling the texture
float getDepthSample(ivec2 pos)
{
  //return LinearizeDepth(texelFetch(imageBuffers[nonuniformEXT(4 + push.frameIndex)], pos, 0).r, ubo.near, ubo.far) / ubo.far;
  return texelFetch(imageBuffers[nonuniformEXT(4 + push.frameIndex)], pos, 0).r;
}

float getDepthSample(vec2 pos)
{
  //texelFetch clears
  return getDepthSample(ivec2(pos.x * ubo.width, pos.y * ubo.height));
}

vec3 getNormalSample(ivec2 pos)
{
  return texelFetch(imageBuffers[nonuniformEXT(6 + push.frameIndex)], pos, 0).rgb;
}

vec3 getNormalSample(vec2 pos)
{
  return getNormalSample(ivec2(pos.x * ubo.width, pos.y * ubo.height));
}


//I fucking beg man
//https://stackoverflow.com/a/32246825
vec3 viewSpacePos(vec2 texUV)
{
    float z = getDepthSample(texUV) * 2.0 - 1.0;

    vec4 clipSpacePosition = vec4(texUV.x * 2.0 - 1.0, texUV.y * 2.f - 1.f, z, 1.0);
    vec4 viewSpacePosition = inverse(ubo.projection) * clipSpacePosition;

    // Perspective division
    viewSpacePosition /= viewSpacePosition.w;

    return viewSpacePosition.xyz;
}

vec3 viewSpacePos(ivec2 texUV)
{
    float z = getDepthSample(texUV) * 2.0 - 1.0;

    vec2 trutexUV = texUV/vec2(ubo.width, ubo.height);

    vec4 clipSpacePosition = vec4(trutexUV * 2.0 - 1.0, z, 1.0);
    vec4 viewSpacePosition = inverse(ubo.projection) * clipSpacePosition;

    // Perspective division
    viewSpacePosition /= viewSpacePosition.w;

    return viewSpacePosition.xyz;
}

const float sampleRadius = 1.5f;
const float hitThickness = 0.5f;
const uint sliceCount = 4;
const uint sampleCount = 8;

//I give up
//for now
//modified version of:
//https://cybereality.com/screen-space-indirect-lighting-with-visibility-bitmask-improvement-to-gtao-ssao-real-time-ambient-occlusion-algorithm-glsl-shader-implementation/
void main()
{
  uint indirect = 0u;
  uint occlusion = 0u;

  vec2 texUV = gl_GlobalInvocationID.xy;
  ivec2 texelCoord = ivec2(texUV);
  texUV /= vec2(push.width, push.height);

  float visibility = 0.0;
  //vec3 lighting = vec3(0.0);
  vec2 frontBackHorizon = vec2(0.0);
  vec2 aspect = vec2(push.height, push.width) / push.width;

  vec3 position = viewSpacePos(texelCoord);

  if (position.z >= ubo.far - 4)
  {
    imageStore(image[nonuniformEXT(8 + push.frameIndex)], ivec2(texelCoord), vec4(1.f));
    return;
  }

  vec3 camera = normalize(-position);
  vec3 normal = getNormalSample(texUV);

  float sliceRotation = twoPi / (sliceCount - 1.0);
  float sampleScale = (sampleRadius * ubo.projection[0][0]) / position.z;
  float sampleOffset = 0.01;
  float jitter = randf(int(texelCoord.x), int(texelCoord.y)) * sampleRadius;

  for (float slice = 0.0; slice < sliceCount + 0.5; slice += 1.0) 
  {
    float phi = sliceRotation * (slice + jitter) + pi;
    vec2 omega = vec2(cos(phi), sin(phi));
    vec3 direction = vec3(omega.x, omega.y, 0.0);
    vec3 orthoDirection = direction - dot(direction, camera) * camera;
    vec3 axis = cross(direction, camera);
    vec3 projNormal = normal - axis * dot(normal, axis);
    float projLength = length(projNormal);

    float signN = sign(dot(orthoDirection, projNormal));
    float cosN = clamp(dot(projNormal, camera) / projLength, 0.0, 1.0);
    float n = signN * acos(cosN);

    for (float currentSample = 0.0; currentSample < sampleCount + 0.5; currentSample += 1.0) 
    {
      float sampleStep = (currentSample + jitter) / sampleCount + sampleOffset;

      //ivec2 sampleCoord = ivec2(texelCoord - sampleStep * sampleScale * omega * aspect);
      vec2 sampleSpot = texUV - sampleStep * sampleScale * omega * aspect;
      clamp(sampleSpot, vec2(0), vec2(1));
      vec3 samplePosition = viewSpacePos(sampleSpot);
      if (samplePosition.z >= ubo.far - 4) continue;


      //vec3 sampleNormal = getNormalSample(sampleSpot);
      //vec3 sampleLight = texture(screenLight, sampleUV).rgb;

      vec3 sampleDistance = samplePosition - position;
      float sampleLength = length(sampleDistance);
      vec3 sampleHorizon = sampleDistance / sampleLength;

      frontBackHorizon.x = dot(sampleHorizon, camera);
      frontBackHorizon.y = dot(normalize(sampleDistance - camera * hitThickness), camera);

      frontBackHorizon = acos(frontBackHorizon);
      frontBackHorizon = clamp((frontBackHorizon + n + halfPi) / pi, 0.0, 1.0);

      indirect = updateSectors(frontBackHorizon.x, frontBackHorizon.y, 0u);
      //lighting += (1.0 - float(bitCount(indirect & ~occlusion)) / float(sectorCount)) *
      //  sampleLight * clamp(dot(normal, sampleHorizon), 0.0, 1.0) *
      //  clamp(dot(sampleNormal, -sampleHorizon), 0.0, 1.0);
      occlusion |= indirect;
    }
    visibility += 1.0 - float(bitCount(occlusion)) / float(sectorCount);
  }

  visibility /= sliceCount;
  //lighting /= sliceCount;

  //visibility = 1 - visibility;

  vec4 color = vec4(vec3(visibility), 1.f);

  imageStore(image[nonuniformEXT(8 + push.frameIndex)], ivec2(texelCoord), color);
}
