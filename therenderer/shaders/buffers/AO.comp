#version 450
#extension GL_EXT_shader_image_load_formatted : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_scalar_block_layout : enable

//size of a workgroup for compute
layout (local_size_x = 32, local_size_y = 32) in;

layout(set = 1, binding = 0) uniform sampler2D textures[];
layout(set = 2, binding = 1) uniform sampler2D imageBuffers[];
layout(rgba16f, set = 2, binding = 0) uniform image2D image[];

#include "../include/common.glsl"

layout(push_constant) uniform Push 
{
  int frameIndex;
  int width;
  int height;
} push;

void main()
{
  ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
  vec3 normal = texelFetch(imageBuffers[nonuniformEXT(6 + push.frameIndex)], texelCoord, 0).rgb;
  float depth = texelFetch(imageBuffers[nonuniformEXT(4 + push.frameIndex)], texelCoord, 0).r;
  vec3 position = vec3(gl_GlobalInvocationID.xy, depth);

  float radius = 1.f;

  float thickness = 0.5f;
  int bitmaskSize = 32;
  int slices = 16;
  int steps = 4;

  float stepSize = radius/(steps + 1);
  float occlusion = 0;

  for (int i = 0; i < slices; i++)
  {
    float sliceAngle = i * M_PI/slices;

    vec3 sliceDirection = vec3(cos(sliceAngle), sin(sliceAngle), 0.0);
    float tangentAngle = atan(sliceDirection.x/sliceDirection.y);

    uint bitmask = 0u;
    for (int j = 0; j < steps; j++)
    {
      uint localBitmask = 0u;

      vec3 frontSample = vec3(position.xy, texelFetch(imageBuffers[nonuniformEXT(4 + push.frameIndex)], texelCoord + ivec2(j + stepSize), 0).r);
      vec3 backSample = frontSample - position/length(position) * thickness;

      //float frontAngle = atan(frontSample.x/frontSample.y);
      //float backAngle = atan(backSample.x/backSample.y);

      //float minAng = min(frontAngle, backAngle);
      //float maxAng = max(frontAngle, backAngle);

      float a = ((minAng + M_PI/2)/M_PI)*bitmaskSize;
      float b = ((maxAng - minAng  + M_PI/2)/M_PI)*bitmaskSize;

      localBitmask = int(pow(2, int(b))) - 1 << int(a);

      bitmask |= localBitmask;
    }

    occlusion += 1 - bitCount(bitmask)/bitmaskSize;
  }

  vec4 color = vec4(vec3(occlusion/slices), 1.f);

  imageStore(image[nonuniformEXT(8 + push.frameIndex)], texelCoord, color);
}
