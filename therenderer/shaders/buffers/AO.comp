#version 450
#extension GL_EXT_shader_image_load_formatted : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_scalar_block_layout : enable

//size of a workgroup for compute
layout (local_size_x = 32, local_size_y = 32) in;

layout(set = 1, binding = 0) uniform sampler2D textures[];
layout(set = 2, binding = 1) uniform sampler2D imageBuffers[];
layout(rgba16f, set = 2, binding = 0) uniform image2D image[];

#include "../include/common.glsl"

layout(set = 0, binding = 0) uniform GlobalUbo 
{
  mat4 projection;
  mat4 view;
  mat4 invView;
  mat4 viewStat;
  vec3 lightPos;
  int numLights;
  vec4 depthValues;
  vec4 ambientLightColor; //RGB Intensity
  PointLight pointLights[10];
  int width;
  int height;
  float near;
  float far;
  mat4 lightSpaceMatrix[4];
  int frameIndex;
} ubo;

#define radius = 1.f;
#define thickness = 0.5f;
#define slices = 4;
#define steps = 8;

layout(push_constant) uniform Push 
{
  int frameIndex;
  int width;
  int height;
} push;

//https://cdrinmatane.github.io/posts/ssaovb-code/
const uint sectorCount = 32u;
uint updateSectors(float minHorizon, float maxHorizon, uint outBitfield) 
{
    uint startBit = uint(minHorizon * float(sectorCount));
    uint horizonAngle = uint(ceil((maxHorizon - minHorizon) * float(sectorCount)));
    uint angleBit = horizonAngle > 0u ? uint(0xFFFFFFFFu >> (sectorCount - horizonAngle)) : 0u;
    uint currentBitfield = angleBit << startBit;
    return outBitfield | currentBitfield;
}

float vectorAngleXY(vec3 angled)
{
  vec3 xyPlane = vec3(1.f, 1.f, 0.f);

  float num = dot(angled, xyPlane);
  float dom = length(angled) * length(xyPlane);

  return fastacos(num/dom);
}

// https://blog.demofox.org/2022/01/01/interleaved-gradient-noise-a-different-kind-of-low-discrepancy-sequence/
float randf(int x, int y) {
    return mod(52.9829189 * mod(0.06711056 * float(x) + 0.00583715 * float(y), 1.0), 1.0);
}

float GetDepthSample(ivec2 pos, bool lowerRes)
{
  return texelFetch(imageBuffers[nonuniformEXT(4 + push.frameIndex)], pos, 0).r;
}

float horizonLoop(vec3 positionVS, vec3 V, vec2 rayStart, vec2 rayDir, float rayOffset, float rayStep, out uint globalOccludedBitfield, vec3 N, int samplingDirection, int mipModifier)
{
  float maxHorizon = -1.0f;  // cos(pi)
  float t = rayOffset * rayStep + rayStep;

  const uint startWithLowerRes = 0;//min(max(0, steps / 2 - 2), 3);

  for (int i = 0; i < steps; i++)
  {
    vec2 samplePos = max(2, min(rayStart + t * rayDir, vec2(push.width, push.height) - 2));

    // Find horizons at these steps:
    float sampleDepth = GetDepthSample(ivec2(samplePos), i > startWithLowerRes);
    vec3 samplePosVS = vec3(samplePos.xy, sampleDepth);

    vec3 deltaPos = samplePosVS - positionVS;

    vec2 frontBackHorizon;
    vec3 deltaPosBackface = deltaPos - V * thickness;

    // Project sample onto the unit circle and compute the angle relative to V
    frontBackHorizon = vec2(dot(normalize(deltaPos), V), dot(normalize(deltaPosBackface), V));
    frontBackHorizon = fastacos(frontBackHorizon);

    // Shift sample from V to normal, clamp in [0..1]
    frontBackHorizon = saturate(((samplingDirection * -frontBackHorizon) - N + M_PI/2) / M_PI);

    // Sampling direction inverts min/max angles
    frontBackHorizon = samplingDirection >= 0 ? frontBackHorizon.yx : frontBackHorizon.xy;

    globalOccludedBitfield = updateSectors(frontBackHorizon.x, frontBackHorizon.y, globalOccludedBitfield);
    t += rayStep;
  }

  return maxHorizon;
}

void main()
{
  ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
  vec2 res = vec2(push.width, push.height);
  vec3 normalVS = normalize(texelFetch(imageBuffers[nonuniformEXT(6 + push.frameIndex)], texelCoord, 0).rgb);
  float depth = texelFetch(imageBuffers[nonuniformEXT(4 + push.frameIndex)], texelCoord, 0).r;
  vec3 position = vec3(gl_GlobalInvocationID.xy, depth);
  vec3 V = normalize(-position);

  float stepSize = radius/(steps + 1);
  float occlusion = 0;

  float sampleScale = (-radius * ubo.projection[0][0]) / position.z;
  float sampleOffset = 0.01f;
  vec2 aspect = vec2(push.height, push.width)/push.width;

  float jitter = randf(texelCoord.x, texelCoord.y) - 0.5;

  for (int i = 0; i < slices; i++)
  {
    float sliceAngle = i * M_PI/slices;

    vec3 dir = normalize(-vec3(vec2(position), i));
    vec3 sliceN = normalize(cross(vec3(dir.xy, 0.f), V));
    vec3 projN = normal - sliceN * dot(normalVS, sliceN);
    float projNLen = length(projN);
    float cosN = dot(projN / projNLen, V);

    vec3 T = cross(V, sliceN)
    float N = -sign(dot(projN, T)) * fastacos(cosN);

    vec2 maxHorizon;

    uint bitmask = 0u;
    maxHorizon.x = horizonLoop(positionVS, V, rayStart, dir, 0, i, bitmask, N, 1, 0);
    maxHorizon.y = HorizonLoop(positionVS, V, rayStart, -dir, 0, i, bitmask, N, -1, 0);

    maxHorizon.x = -fastacos(maxHorizon.x);
    maxHorizon.y = fastacos(maxHorizon.y);

    maxHorizon.x = N + max(maxHorizon.x - N, -M_PI/2);
    maxHorizon.y = N + min(maxHorizon.y - N, M_PI/2);

    occlusion += 1 - bitCount(bitmask)/sectorCount;
  }

  vec4 color = vec4(vec3(occlusion/slices), 1.f);

  imageStore(image[nonuniformEXT(8 + push.frameIndex)], texelCoord, color);
}
